<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-feature android:name="android.hardware.type.watch" />

  <!--
    Der Kalender-Provider der UHR, nicht des Handys. Ob dein Arbeitskalender
    dort ankommt, haengt am Sync-Setup — siehe docs/ARCHITECTURE.md, Abschnitt 4.
  -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />

  <!--
    Package Visibility, ab Android 11 Pflicht.

    Ohne diese Deklaration ist Samsungs Complication-Provider fuer uns schlicht
    nicht existent: ContentResolver.query() liefert dann stillschweigend `null`
    statt einer SecurityException. Genau das ist auf der Watch Ultra passiert —
    die adb-Shell durfte lesen, unsere App bekam null und fiel unbemerkt auf
    den leeren AOSP-Kalender zurueck.
  -->
  <queries>
    <provider android:authorities="com.google.android.wearable.provider.calendar" />
    <provider android:authorities="com.android.calendar" />
  </queries>

  <!--
    Adaptive Icon fuer alles ab API 26, plus roundIcon, weil der Wear-Launcher
    rund maskiert. Beides generiert von tools/genicon.mjs aus der icon-Spec in
    design/geometry.json — das Motiv sind die zwei Ribbon-Bahnen des
    Zifferblatts, reduziert auf zwei ueberlappende Halbkreise.
  -->
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="true">

    <meta-data
        android:name="com.google.android.wearable.standalone"
        android:value="true" />

    <!--
      Detailansicht. Ziel des Taps auf den Agenda-Slot des Zifferblatts.

      screenOrientation="nosensor": ein rundes Zifferblatt hat keine sinnvolle
      Querformat-Variante. Ohne diese Angabe darf das System die Ansicht dem
      Beschleunigungssensor folgen lassen, was am Handgelenk nur verwirrt.
    -->
    <activity
        android:name=".OrganizerActivity"
        android:exported="true"
        android:label="@string/app_name"
        android:screenOrientation="nosensor"
        android:taskAffinity=""
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      Complication-Provider. Diese API ist ausdruecklich NICHT deprecated —
      nur die Watchface-Renderer-APIs sind es.

      UPDATE_PERIOD_SECONDS ist ein Wunsch, keine Garantie: das System darf
      drosseln. Deshalb liegen die Zeiger nativ im WFF und nicht in diesem
      Bitmap. Zusaetzlich stoesst ein ContentObserver auf dem Kalender ein
      Update an, sobald sich Termine aendern.
    -->
    <service
        android:name=".AgendaComplicationService"
        android:exported="true"
        android:label="@string/complication_label"
        android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
      <intent-filter>
        <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
      </intent-filter>
      <!--
        LARGE_IMAGE, nicht PHOTO_IMAGE.

        Die Manifest-Metadaten benutzen die Legacy-Bezeichner der Wearable
        Support Library; PHOTO_IMAGE ist der Name derselben Sache in der
        androidx-API. Steht hier ein unbekannter Wert, meldet der Service
        gar keinen Typ an: er erscheint dann nicht im Complication-Picker,
        und die DefaultProviderPolicy im Watchface ueberspringt ihn
        stillschweigend. Referenz: android/wear-os-samples, Complications.
      -->
      <meta-data
          android:name="android.support.wearable.complications.SUPPORTED_TYPES"
          android:value="LARGE_IMAGE" />
      <meta-data
          android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
          android:value="60" />
    </service>
  </application>
</manifest>
